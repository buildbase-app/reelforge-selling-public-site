# Public, non-secret production values for the ReelForge store.
# `next build` inlines NEXT_PUBLIC_* from this file, and OpenNext embeds the
# file into the Worker so server code sees the same values at runtime.
# Wrangler vars/secrets take precedence over these at runtime.
#
# NEVER put secrets here. BUILDBASE_CLIENT_SECRET, BUILDBASE_WEBHOOK_SECRET
# and SYSTEM_SECRET are set with `wrangler secret put` (DEPLOY_CLOUDFLARE.md).

SITE_URL=https://reelforge-store.hackathon-f12.workers.dev
NEXT_PUBLIC_SITE_URL=https://reelforge-store.hackathon-f12.workers.dev

NEXT_PUBLIC_BUILDBASE_SERVER_URL=https://api.console.buildbase.app
NEXT_PUBLIC_BUILDBASE_ORG_ID=6b01478bb42d2c444e99fcd8
NEXT_PUBLIC_BUILDBASE_CLIENT_ID=XUlR38I2gOAZOCpxleNxgPURGpHlzsykAMwypHS8
NEXT_PUBLIC_BUILDBASE_REDIRECT_URL=https://reelforge-store.hackathon-f12.workers.dev
# Empty = the organization's production environment.
NEXT_PUBLIC_BUILDBASE_ENVIRONMENT=
