# Public, non-secret production values for the RenderWeld store.
# `next build` inlines NEXT_PUBLIC_* from this file, and OpenNext embeds the
# file into the Worker so server code sees the same values at runtime.
# Wrangler vars/secrets take precedence over these at runtime.
#
# NEVER put secrets here. BUILDBASE_CLIENT_SECRET, BUILDBASE_WEBHOOK_SECRET
# and SYSTEM_SECRET are set with `wrangler secret put` (DEPLOY_CLOUDFLARE.md).

SITE_URL=https://renderweld.com
NEXT_PUBLIC_SITE_URL=https://renderweld.com

NEXT_PUBLIC_BUILDBASE_SERVER_URL=https://api.console.buildbase.app
NEXT_PUBLIC_BUILDBASE_ORG_ID=6b01478bb42d2c444e99fcd8
NEXT_PUBLIC_BUILDBASE_CLIENT_ID=XUlR38I2gOAZOCpxleNxgPURGpHlzsykAMwypHS8
NEXT_PUBLIC_BUILDBASE_REDIRECT_URL=https://renderweld.com
# Empty = the organization's production environment.
NEXT_PUBLIC_BUILDBASE_ENVIRONMENT=

# Public support address (founder decision 2026-11-27).
NEXT_PUBLIC_SUPPORT_EMAIL=hello@renderweld.com

# The BuildBase form behind /contact (console: Forms > Contact, in Render Weld
# production). Public: it only reads the form and posts to it.
NEXT_PUBLIC_BUILDBASE_CONTACT_FORM_ID=wlWxJcmz2afuzLl

# Search engine verification (the content="" value of each engine's meta
# tag). Empty = the tag is omitted. Public values, inlined at build time.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=
