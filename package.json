{
  "name": "reelforge-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "build": "prisma generate && next build",
    "build:analyze": "ANALYZE=true npm run build",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:mcp-tools": "node scripts/agents/refresh-mcp-tools.mjs --check",
    "prepare": "husky",
    "content:pull": "node scripts/pull-content.mjs",
    "postinstall": "prisma generate",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --include-runtime=false cloudflare-env.d.ts",
    "db:migration": "node scripts/db-migration.mjs",
    "db:migrate:local": "wrangler d1 migrations apply reelforge-store --local",
    "db:migrate:remote": "wrangler d1 migrations apply reelforge-store --remote",
    "deploy:dev": "NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION= NEXT_PUBLIC_BING_SITE_VERIFICATION= NEXT_PUBLIC_YANDEX_SITE_VERIFICATION= NEXT_PUBLIC_SITE_URL=https://reelforge-dev.buildbase.app SITE_URL=https://reelforge-dev.buildbase.app NEXT_PUBLIC_BUILDBASE_REDIRECT_URL=https://reelforge-dev.buildbase.app NEXT_PUBLIC_BUILDBASE_ORG_ID=6b01478bb42d2c444e99fcd8 NEXT_PUBLIC_BUILDBASE_CLIENT_ID=gqLbQtwsNKyzl2dKtx7v2u2GVAhP6AzPpAe1GvL7 NEXT_PUBLIC_BUILDBASE_ENVIRONMENT=fsyqdskf opennextjs-cloudflare build && opennextjs-cloudflare deploy --env dev",
    "db:migrate:dev": "wrangler d1 migrations apply reelforge-store-dev --remote --env dev",
    "e2e:buyer": "node scripts/e2e-buyer-journey.cjs",
    "e2e:personal": "node scripts/e2e-personal-claim.cjs"
  },
  "dependencies": {
    "@buildbase/sdk": "^1.8.0",
    "@hookform/resolvers": "^5.2.2",
    "@opennextjs/cloudflare": "^1.20.18",
    "@prisma/adapter-d1": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.78.0",
    "@shikijs/core": "^4.0.2",
    "@shikijs/engine-javascript": "^4.0.2",
    "@shikijs/langs": "^4.0.2",
    "@shikijs/themes": "^4.0.2",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@tanstack/react-query": "^5.95.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "hast-util-to-string": "^3.0.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.562.0",
    "next": "16.4.6",
    "next-intl": "^4.7.0",
    "next-seo": "^7.2.0",
    "next-themes": "^0.4.6",
    "prisma": "^7.10.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "rss": "^1.2.2",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@next/bundle-analyzer": "^16.4.6",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@tanstack/react-query-devtools": "^5.95.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/rss": "^0.0.32",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "^16.2.9",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.12",
    "wrangler": "^4.166.0"
  },
  "overrides": {
    "minimatch": "^10.0.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "@opennextjs/aws": {
      "cookie": "0.7.2"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
